    "@ui5/webcomponents-react": "2.27.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@ui5/webcomponents-cypress-commands": "2.27.3",
    "@vitejs/plugin-react": "6.1.2",
    "cypress": "16.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
