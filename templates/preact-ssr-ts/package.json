{
  "name": "preact-ssr-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.ts",
    "build": "tsc && npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "cross-env NODE_ENV=production node server.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ui5/webcomponents": "2.27.2",
    "@ui5/webcomponents-base": "2.27.2",
    "@ui5/webcomponents-fiori": "2.27.2",
    "@ui5/webcomponents-icons": "2.27.2",
    "@ui5/webcomponents-react": "2.27.3",
    "compression": "1.8.2",
    "express": "5.2.1",
    "preact": "11.0.1",
    "preact-render-to-string": "6.8.0",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@preact/preset-vite": "2.10.6",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
